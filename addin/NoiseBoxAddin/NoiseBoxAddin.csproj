<Project Sdk="Microsoft.NET.Sdk">
  <!--
    NoiseBox add-in for ArcGIS Pro 3.5 (.NET 8). Builds with `dotnet build` (checked with SDK 11.0.100). Esri's NuGet
    package is used for the reference assemblies only (ExcludeAssets="build"): its packaging target needs Visual Studio's
    MSBuild, so setup\build_addin.ps1 zips Config.daml + the assembly into dist\NoiseBox.esriAddinX itself.
    Alternatively build in Visual Studio 2022 with the ArcGIS Pro SDK extension (copy the sources into a template project).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NoiseBoxAddin</RootNamespace>
    <AssemblyName>NoiseBoxAddin</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NoWarn>$(NoWarn);CA1416;NETSDK1138</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Esri's Pro SDK reference + packaging targets (builds the .esriAddinX). Pin to the Pro 3.5 build you have. -->
    <PackageReference Include="Esri.ArcGISPro.Extensions30" Version="3.5.*" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>
  <ItemGroup>
    <AddInContent Include="Config.daml" />
    <!-- Ribbon icons: Images\<Name>16.png and <Name>32.png, embedded in the assembly as WPF resources and referenced from Config.daml as ImagesName.png, the only form Pro 3.5 resolves (generated by docs\make_icons.py; replace freely) -->
    <Resource Include="Images\*.png" />
    <AddInContent Include="Images\*.png" />
    <EmbeddedResource Include="Resources\scenario_template.json" LogicalName="NoiseBoxAddin.scenario_template.json" />
  </ItemGroup>
</Project>
