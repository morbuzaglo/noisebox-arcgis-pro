<?xml version="1.0" encoding="utf-8" ?>
<!-- NoiseBox ribbon tab: six groups, split buttons where several ways exist for one action, one dockable pane.
     Not yet loaded in ArcGIS Pro (see NoiseBoxAddin.csproj). -->
<ArcGIS defaultAssembly="NoiseBoxAddin.dll"
        defaultNamespace="NoiseBoxAddin"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">

  <AddInInfo id="{6B0C3A2E-4D52-4E0B-9B52-0F7B8C1E5A11}" version="1.24" desktopVersion="3.5.0">
    <Name>NoiseBox</Name>
    <Description>Outdoor noise mapping (ISO 9613-2) with a MATLAB core: scenarios, sources, structures, enclosures, receiver grids.</Description>
    <Date>2026-11-19</Date>
    <Subject>Analysis</Subject>
  </AddInInfo>

  <modules>
    <insertModule id="NoiseBox_Module" className="NoiseBoxModule" autoLoad="false" caption="NoiseBox">

      <tabs>
        <tab id="NoiseBox_Tab" caption="NoiseBox" keytip="NB">
          <group refID="NoiseBox_Group_Scenario" />
          <group refID="NoiseBox_Group_Source" />
          <group refID="NoiseBox_Group_Terrain" />
          <group refID="NoiseBox_Group_Structures" />
          <group refID="NoiseBox_Group_Propagation" />
          <group refID="NoiseBox_Group_Analysis" />
        </tab>
      </tabs>

      <groups>
        <group id="NoiseBox_Group_Scenario" keytip="N01" caption="Scenario" appearsOnAddInTab="false">
          <button refID="NoiseBox_Scenario_New" size="large" />
          <button refID="NoiseBox_Scenario_Open" size="large" />
          <button refID="NoiseBox_Scenario_Save" size="large" />
          <button refID="NoiseBox_Scenario_Duplicate" size="large" />
        </group>
        <group id="NoiseBox_Group_Source" keytip="N02" caption="Source" appearsOnAddInTab="false">
          <splitButton refID="NoiseBox_SetLocation" size="large" />
          <button refID="NoiseBox_Spectrum" size="large" />
          <button refID="NoiseBox_Directivity" size="large" />
        </group>
        <group id="NoiseBox_Group_Terrain" keytip="N03" caption="Terrain and Area" appearsOnAddInTab="false">
          <splitButton refID="NoiseBox_SelectDtm" size="large" />
          <splitButton refID="NoiseBox_SetArea" size="large" />
          <button refID="NoiseBox_ReceiverGrid" size="large" />
        </group>
        <group id="NoiseBox_Group_Structures" keytip="N04" caption="Structures" appearsOnAddInTab="false">
          <splitButton refID="NoiseBox_AddBuilding" size="large" />
          <splitButton refID="NoiseBox_AddBarrier" size="large" />
          <splitButton refID="NoiseBox_AddEnclosure" size="large" />
        </group>
        <group id="NoiseBox_Group_Propagation" keytip="N05" caption="Propagation" appearsOnAddInTab="false">
          <button refID="NoiseBox_Ground" size="large" />
          <button refID="NoiseBox_Atmosphere" size="large" />
          <button refID="NoiseBox_TerrainScreening" size="large" />
          <button refID="NoiseBox_Meteorology" size="large" />
        </group>
        <group id="NoiseBox_Group_Analysis" keytip="N06" caption="Analysis" appearsOnAddInTab="false">
          <button refID="NoiseBox_Preview" size="large" />
          <button refID="NoiseBox_Run" size="large" />
          <button refID="NoiseBox_Results" size="large" />
        </group>
      </groups>

      <controls>
        <!-- Scenario -->
        <button id="NoiseBox_Scenario_New" keytip="N07" smallImage="Images\Scenario_New16.png" largeImage="Images\Scenario_New32.png" caption="New" className="Buttons.NewScenario" loadOnClick="true">
          <tooltip heading="New scenario">Start an empty scenario. Constants have defaults; the source, area and outputs are yours to set.</tooltip>
        </button>
        <button id="NoiseBox_Scenario_Open" keytip="N08" smallImage="Images\Scenario_Open16.png" largeImage="Images\Scenario_Open32.png" caption="Open" className="Buttons.OpenScenario" loadOnClick="true">
          <tooltip heading="Open scenario">Open a saved scenario file (.nbscenario.json).</tooltip>
        </button>
        <button id="NoiseBox_Scenario_Save" keytip="N09" smallImage="Images\Scenario_Save16.png" largeImage="Images\Scenario_Save32.png" caption="Save" className="Buttons.SaveScenario" loadOnClick="true">
          <tooltip heading="Save scenario">Save the scenario file. The GIS data it refers to is never changed.</tooltip>
        </button>
        <button id="NoiseBox_Scenario_Duplicate" keytip="N10" smallImage="Images\Scenario_Duplicate16.png" largeImage="Images\Scenario_Duplicate32.png" caption="Duplicate" className="Buttons.DuplicateScenario" loadOnClick="true">
          <tooltip heading="Duplicate scenario">Copy the scenario, e.g. to test a mitigation next to the baseline.</tooltip>
        </button>

        <!-- Source: Set Location with three equivalent ways -->
        <button id="NoiseBox_SetLocation_FromLayer" keytip="N11" smallImage="Images\SetLocation_FromLayer16.png" largeImage="Images\SetLocation_FromLayer32.png" caption="Location from Layer" className="Buttons.SourceFromLayer" loadOnClick="true">
          <tooltip heading="From Layer">Use a point from a layer: the selected feature, a feature picked on the map, or one chosen by name or ID.</tooltip>
        </button>
        <button id="NoiseBox_SetLocation_Coordinates" keytip="N12" smallImage="Images\SetLocation_Coordinates16.png" largeImage="Images\SetLocation_Coordinates32.png" caption="Enter Coordinates" className="Buttons.SourceFromCoordinates" loadOnClick="true">
          <tooltip heading="Enter Coordinates">Type or paste a coordinate pair in a coordinate system you choose.</tooltip>
        </button>
        <button id="NoiseBox_SetLocation_PlaceOnMap" keytip="N13" smallImage="Images\SetLocation_PlaceOnMap16.png" largeImage="Images\SetLocation_PlaceOnMap32.png" caption="Place on Map" className="Buttons.SourcePlaceOnMap" loadOnClick="true">
          <tooltip heading="Place on Map">Click the map to place the source. Esc cancels.</tooltip>
        </button>
        <tool id="NoiseBox_PlaceSourceTool" keytip="N14" smallImage="Images\PlaceSourceTool16.png" largeImage="Images\PlaceSourceTool32.png" caption="Place Source" className="Tools.PlaceSourceTool" loadOnClick="true" categoryRefID="esri_mapping_mapTools" />
        <tool id="NoiseBox_MoveSourceTool" keytip="N15" smallImage="Images\MoveSourceTool16.png" largeImage="Images\MoveSourceTool32.png" caption="Move Source" className="Tools.MoveSourceTool" loadOnClick="true" categoryRefID="esri_mapping_mapTools" />
        <tool id="NoiseBox_PickSourceTool" keytip="N16" smallImage="Images\PickSourceTool16.png" largeImage="Images\PickSourceTool32.png" caption="Pick Source Feature" className="Tools.PickSourceTool" loadOnClick="true" categoryRefID="esri_mapping_mapTools" />
        <tool id="NoiseBox_HeadingTool" keytip="N17" smallImage="Images\HeadingTool16.png" largeImage="Images\HeadingTool32.png" caption="Rotate Heading" className="Tools.HeadingTool" loadOnClick="true" categoryRefID="esri_mapping_mapTools" />
        <button id="NoiseBox_Spectrum" keytip="N18" smallImage="Images\Spectrum16.png" largeImage="Images\Spectrum32.png" caption="Source Spectrum" className="Buttons.OpenSpectrum" loadOnClick="true">
          <tooltip heading="Source spectrum">Octave-band sound power Lw (dB re 1 pW): type, paste, import CSV, or load a named profile.</tooltip>
        </button>
        <button id="NoiseBox_Directivity" keytip="N19" smallImage="Images\Directivity16.png" largeImage="Images\Directivity32.png" caption="Directivity" className="Buttons.OpenDirectivity" loadOnClick="true">
          <tooltip heading="Directivity">Omnidirectional, or a constant correction Dc per band (the engine has no angular table yet).</tooltip>
        </button>

        <!-- Terrain and Area -->
        <button id="NoiseBox_Dtm_FromProject" keytip="N20" smallImage="Images\Dtm_FromProject16.png" largeImage="Images\Dtm_FromProject32.png" caption="DTM from Project Rasters" className="Buttons.DtmFromProject" loadOnClick="true" />
        <button id="NoiseBox_Dtm_Ground" keytip="N57" smallImage="Images\Dtm_Ground16.png" largeImage="Images\Dtm_Ground32.png" caption="DTM from Map Ground" className="Buttons.DtmGround" loadOnClick="true">
          <tooltip heading="DTM from Map Ground">Use the raster that is the ground elevation source of the active map (Contents &gt; Elevation Surfaces &gt; Ground).</tooltip>
        </button>
        <button id="NoiseBox_Dtm_Browse" keytip="N21" smallImage="Images\Dtm_Browse16.png" largeImage="Images\Dtm_Browse32.png" caption="Browse..." className="Buttons.DtmBrowse" loadOnClick="true" />
        <button id="NoiseBox_Dtm_Coverage" keytip="N22" smallImage="Images\Dtm_Coverage16.png" largeImage="Images\Dtm_Coverage32.png" caption="Show Coverage" className="Buttons.DtmCoverage" loadOnClick="true">
          <tooltip heading="Show Coverage">Draw the DTM footprint and the gaps along source-to-receiver paths.</tooltip>
        </button>
        <button id="NoiseBox_Dtm_None" keytip="N23" smallImage="Images\Dtm_None16.png" largeImage="Images\Dtm_None32.png" caption="Flat Ground (no DTM)" className="Buttons.DtmNone" loadOnClick="true" />
        <button id="NoiseBox_Area_Polygons" keytip="N24" smallImage="Images\Area_Polygons16.png" largeImage="Images\Area_Polygons32.png" caption="Area from Polygons" className="Buttons.AreaFromPolygons" loadOnClick="true" />
        <button id="NoiseBox_Area_DrawPolygon" keytip="N25" smallImage="Images\Area_DrawPolygon16.png" largeImage="Images\Area_DrawPolygon32.png" caption="Draw Polygon" className="Buttons.AreaDrawPolygon" loadOnClick="true" />
        <button id="NoiseBox_Area_DrawRectangle" keytip="N26" smallImage="Images\Area_DrawRectangle16.png" largeImage="Images\Area_DrawRectangle32.png" caption="Draw Rectangle" className="Buttons.AreaDrawRectangle" loadOnClick="true" />
        <button id="NoiseBox_Area_Radius" keytip="N27" smallImage="Images\Area_Radius16.png" largeImage="Images\Area_Radius32.png" caption="Radius Around Source" className="Buttons.AreaRadius" loadOnClick="true" />
        <button id="NoiseBox_Area_MapExtent" keytip="N28" smallImage="Images\Area_MapExtent16.png" largeImage="Images\Area_MapExtent32.png" caption="Capture Map Extent" className="Buttons.AreaMapExtent" loadOnClick="true" />
        <tool id="NoiseBox_AreaPolygonTool" keytip="N29" smallImage="Images\AreaPolygonTool16.png" largeImage="Images\AreaPolygonTool32.png" caption="Draw Analysis Area" className="Tools.AreaPolygonTool" loadOnClick="true" categoryRefID="esri_mapping_mapTools" />
        <tool id="NoiseBox_AreaRectangleTool" keytip="N30" smallImage="Images\AreaRectangleTool16.png" largeImage="Images\AreaRectangleTool32.png" caption="Draw Analysis Rectangle" className="Tools.AreaRectangleTool" loadOnClick="true" categoryRefID="esri_mapping_mapTools" />
        <button id="NoiseBox_ReceiverGrid" keytip="N31" smallImage="Images\ReceiverGrid16.png" largeImage="Images\ReceiverGrid32.png" caption="Receiver Grid" className="Buttons.OpenReceiverGrid" loadOnClick="true">
          <tooltip heading="Receiver grid">Output cell size (match the DTM or custom) and receiver height above local ground.</tooltip>
        </button>

        <!-- Structures -->
        <button id="NoiseBox_Building_FromLayer" keytip="N32" smallImage="Images\Building_FromLayer16.png" largeImage="Images\Building_FromLayer32.png" caption="Building from Layer" className="Buttons.BuildingFromLayer" loadOnClick="true" />
        <button id="NoiseBox_Building_Draw" keytip="N33" smallImage="Images\Building_Draw16.png" largeImage="Images\Building_Draw32.png" caption="Draw Footprint" className="Buttons.BuildingDraw" loadOnClick="true" />
        <tool id="NoiseBox_BuildingTool" keytip="N34" smallImage="Images\BuildingTool16.png" largeImage="Images\BuildingTool32.png" caption="Draw Building Footprint" className="Tools.BuildingTool" loadOnClick="true" categoryRefID="esri_mapping_mapTools" />
        <button id="NoiseBox_Barrier_FromLayer" keytip="N35" smallImage="Images\Barrier_FromLayer16.png" largeImage="Images\Barrier_FromLayer32.png" caption="Barrier from Layer" className="Buttons.BarrierFromLayer" loadOnClick="true" />
        <button id="NoiseBox_Barrier_Sketch" keytip="N36" smallImage="Images\Barrier_Sketch16.png" largeImage="Images\Barrier_Sketch32.png" caption="Sketch on Map" className="Buttons.BarrierSketch" loadOnClick="true" />
        <button id="NoiseBox_Barrier_Precise" keytip="N37" smallImage="Images\Barrier_Precise16.png" largeImage="Images\Barrier_Precise32.png" caption="Precise Placement" className="Buttons.BarrierPrecise" loadOnClick="true">
          <tooltip heading="Precise placement">Start point, length, azimuth and height; the barrier updates as you edit the numbers.</tooltip>
        </button>
        <tool id="NoiseBox_BarrierTool" keytip="N38" smallImage="Images\BarrierTool16.png" largeImage="Images\BarrierTool32.png" caption="Sketch Noise Barrier" className="Tools.BarrierTool" loadOnClick="true" categoryRefID="esri_mapping_mapTools" />
        <tool id="NoiseBox_BarrierStartTool" keytip="N39" smallImage="Images\BarrierStartTool16.png" largeImage="Images\BarrierStartTool32.png" caption="Place Barrier Start" className="Tools.BarrierStartTool" loadOnClick="true" categoryRefID="esri_mapping_mapTools" />
        <button id="NoiseBox_Enclosure_Rectangle" keytip="N40" smallImage="Images\Enclosure_Rectangle16.png" largeImage="Images\Enclosure_Rectangle32.png" caption="Enclosure Quick Rectangle" className="Buttons.EnclosureRectangle" loadOnClick="true" />
        <button id="NoiseBox_Enclosure_Draw" keytip="N41" smallImage="Images\Enclosure_Draw16.png" largeImage="Images\Enclosure_Draw32.png" caption="Draw Footprint" className="Buttons.EnclosureDraw" loadOnClick="true" />
        <tool id="NoiseBox_EnclosureTool" keytip="N42" smallImage="Images\EnclosureTool16.png" largeImage="Images\EnclosureTool32.png" caption="Draw Enclosure Footprint" className="Tools.EnclosureTool" loadOnClick="true" categoryRefID="esri_mapping_mapTools" />
        <tool id="NoiseBox_PickStructureTool" keytip="N43" smallImage="Images\PickStructureTool16.png" largeImage="Images\PickStructureTool32.png" caption="Select Structure" className="Tools.PickStructureTool" loadOnClick="true" categoryRefID="esri_mapping_mapTools" />

        <!-- Propagation -->
        <button id="NoiseBox_Ground" keytip="N44" smallImage="Images\Ground16.png" largeImage="Images\Ground32.png" caption="Ground" className="Buttons.OpenGround" loadOnClick="true" />
        <button id="NoiseBox_Atmosphere" keytip="N45" smallImage="Images\Atmosphere16.png" largeImage="Images\Atmosphere32.png" caption="Atmosphere" className="Buttons.OpenAtmosphere" loadOnClick="true" />
        <button id="NoiseBox_TerrainScreening" keytip="N46" smallImage="Images\TerrainScreening16.png" largeImage="Images\TerrainScreening32.png" caption="Terrain Screening" className="Buttons.OpenTerrainScreening" loadOnClick="true" />
        <button id="NoiseBox_Meteorology" keytip="N47" smallImage="Images\Meteorology16.png" largeImage="Images\Meteorology32.png" caption="Meteorology" className="Buttons.OpenMeteorology" loadOnClick="true" />

        <!-- Analysis -->
        <button id="NoiseBox_Preview" keytip="N48" smallImage="Images\Preview16.png" largeImage="Images\Preview32.png" caption="Preview" className="Buttons.Preview" loadOnClick="true">
          <tooltip heading="Preview">Fast check, no acoustic calculation: shows the source, heading, area, structures in the run, DTM gaps, and every issue.</tooltip>
        </button>
        <button id="NoiseBox_Run" keytip="N49" smallImage="Images\Run16.png" largeImage="Images\Run32.png" caption="Run" className="Buttons.Run" loadOnClick="true">
          <tooltip heading="Run">Calculate with the MATLAB core and add the results to a named group in Contents.</tooltip>
        </button>
        <button id="NoiseBox_Results" keytip="N50" smallImage="Images\Results16.png" largeImage="Images\Results32.png" caption="Results" className="Buttons.OpenResults" loadOnClick="true" />
      </controls>
      <splitButtons>
        <splitButton id="NoiseBox_SetLocation" keytip="N51">
          <button refID="NoiseBox_SetLocation_FromLayer" />
          <button refID="NoiseBox_SetLocation_Coordinates" />
          <button refID="NoiseBox_SetLocation_PlaceOnMap" />
        </splitButton>
        <splitButton id="NoiseBox_SelectDtm" keytip="N52">
          <button refID="NoiseBox_Dtm_FromProject" />
          <button refID="NoiseBox_Dtm_Ground" />
          <button refID="NoiseBox_Dtm_Browse" />
          <button refID="NoiseBox_Dtm_Coverage" />
          <button refID="NoiseBox_Dtm_None" />
        </splitButton>
        <splitButton id="NoiseBox_SetArea" keytip="N53">
          <button refID="NoiseBox_Area_Polygons" />
          <button refID="NoiseBox_Area_DrawPolygon" />
          <button refID="NoiseBox_Area_DrawRectangle" />
          <button refID="NoiseBox_Area_Radius" />
          <button refID="NoiseBox_Area_MapExtent" />
        </splitButton>
        <splitButton id="NoiseBox_AddBuilding" keytip="N54">
          <button refID="NoiseBox_Building_FromLayer" />
          <button refID="NoiseBox_Building_Draw" />
        </splitButton>
        <splitButton id="NoiseBox_AddBarrier" keytip="N55">
          <button refID="NoiseBox_Barrier_FromLayer" />
          <button refID="NoiseBox_Barrier_Sketch" />
          <button refID="NoiseBox_Barrier_Precise" />
        </splitButton>
        <splitButton id="NoiseBox_AddEnclosure" keytip="N56">
          <button refID="NoiseBox_Enclosure_Rectangle" />
          <button refID="NoiseBox_Enclosure_Draw" />
        </splitButton>
      </splitButtons>

      <dockPanes>
        <dockPane id="NoiseBox_Pane" caption="NoiseBox" image="Images\Pane16.png" className="UI.NoiseBoxPaneViewModel" dock="group" dockWith="esri_core_projectDockPane">
          <content className="UI.NoiseBoxPaneView" />
        </dockPane>
      </dockPanes>
    </insertModule>
  </modules>
</ArcGIS>
